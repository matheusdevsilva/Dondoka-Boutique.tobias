# Copie para .env antes de rodar `docker compose up`.
# Gere valores aleatórios com: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Senha do primeiro admin (mín. 10 caracteres). Usada só quando a tabela admin está vazia.
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# URL pública da loja (nginx serve front e /api na mesma origem).
PUBLIC_URL=http://localhost:5173
# Cookies de sessão só trafegam em HTTPS (localhost é exceção nos navegadores).
# Use false apenas para testar via IP da rede local sem HTTPS.
COOKIE_SECURE=true

SHIPPING_FEE=15
VITE_WHATSAPP=5511949316452
VITE_INSTAGRAM=https://www.instagram.com/dondokaboutique.tobias/
