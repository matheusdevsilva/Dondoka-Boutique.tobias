PORT=5000
NODE_ENV=production
# Obrigatório: valor aleatório com 32+ caracteres (openssl rand -hex 32)
JWT_SECRET=
SHIPPING_FEE=15

# Render injeta DATABASE_URL automaticamente no Blueprint
DATABASE_URL=postgresql://user:pass@host:5432/dondoka
# Alternativas locais:
# DATABASE_URL_PUBLIC=postgresql://...
# DATABASE_URL_PRIVATE=postgresql://...

# SSL do banco: verificado por padrão em hosts remotos.
# DATABASE_SSL=false                      # desliga SSL (rede interna)
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n..."
# DATABASE_SSL_REJECT_UNAUTHORIZED=false  # só se o provedor não tiver certificado válido

# Primeiro admin (usado só quando a tabela admin está vazia; mín. 10 caracteres)
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=

# Origem do front (separar por vírgula se tiver mais de uma). Obrigatório em produção.
CORS_ORIGIN=https://dondoka-web.onrender.com
FRONTEND_URL=https://dondoka-web.onrender.com

# Cookie de sessão. Padrão em produção: SameSite=None + Secure (front e API em domínios diferentes).
# Se o front servir /api pelo mesmo domínio (nginx do docker-compose), prefira lax.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# Quantos proxies reversos estão na frente da API (afeta IP do rate limit). Padrão: 1 em produção.
# TRUST_PROXY=1
